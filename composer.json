{
    "name": "havokinspiration/wrench",
    "description": "Maintenance mode plugin for CakePHP 3.X",
    "type": "cakephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Yves Piquel",
            "homepage": "https://github.com/HavokInspiration/wrench"
        }
    ],
    "support": {
        "issues": "https://github.com/HavokInspiration/wrench/issues",
        "source": "https://github.com/HavokInspiration/wrench"
    },
    "require": {
        "php": ">=5.6.0|<=7.4",
        "cakephp/cakephp": "^3.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7.14|^6",
        "cakephp/bake": "1.*",
        "cakephp/cakephp-codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Wrench\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wrench\\Test\\": "tests",
            "Cake\\Test\\": "./vendor/cakephp/cakephp/tests",
            "App\\": "tests/test_app/App"
        }
    },
    "scripts": {
        "analyse": [
            "@stan"
         ],
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs -n -p --standard=vendor/cakephp/cakephp-codesniffer/CakePHP ./src ./tests",
        "cs-fix": "phpcbf --standard=vendor/cakephp/cakephp-codesniffer/CakePHP ./src ./tests",
        "test": "phpunit --stderr",
        "stan": "phpstan analyse src/",
        "stan-setup": "cp composer.json composer.backup && composer require --dev phpstan/phpstan && mv composer.backup composer.json"
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
