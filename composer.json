{
    "name": "havokinspiration/wrench",
    "description": "Maintenance mode plugin for CakePHP 3.X",
    "type": "cakephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Yves Piquel",
            "homepage": "https://github.com/HavokInspiration/wrench"
        }
    ],
    "support": {
        "issues": "https://github.com/HavokInspiration/wrench/issues",
        "source": "https://github.com/HavokInspiration/wrench"
    },
    "require": {
        "php": ">=5.6.0|<=7.4",
        "cakephp/cakephp": "^3.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7.14|^6",
        "cakephp/bake": "1.*",
        "cakephp/cakephp-codesniffer": "^3.0",
        "phpstan/phpstan": "*"
    },
    "autoload": {
        "psr-4": {
            "Wrench\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wrench\\Test\\": "tests",
            "Cake\\Test\\": "./vendor/cakephp/cakephp/tests",
            "App\\": "tests/test_app/App"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    }
}
